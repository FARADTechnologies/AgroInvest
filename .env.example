# Copy to .env and change the secrets before any non-demo use.
# docker compose reads this file automatically.

# PostgreSQL
POSTGRES_DB=agro
POSTGRES_USER=agro
POSTGRES_PASSWORD=change-me-db-password

# API
ENVIRONMENT=demo
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_MINUTES=60
# Set to true only when the portal is served over HTTPS.
COOKIE_SECURE=false

# EKTIS integration: "mock" talks to the bundled ektis-mock service.
# A real client is selected here once the authority grants access.
EKTIS_MODE=mock
EKTIS_BASE_URL=http://ektis-mock:8081/ektis/v1
EKTIS_API_KEY=change-me-ektis-key
EKTIS_HMAC_SECRET=change-me-ektis-hmac

# Demo accounts are created by the seed with this password. It is published
# in the README on purpose so the jury and testers can sign in; never reuse it.
DEMO_PASSWORD=Demo2026!
